# Ignore Python bytecode
__pycache__/
*.py[cod]

# Ignore environment variables
.env

# Ignore IDE files
.vscode/
.idea/

# Ignore logs
*.log
generator_log_*.txt
*_log_*.txt

# Ignore temporary files
*.tmp
*.temp

# Ignore other files
.DS_Store
Thumbs.db

# Generated files and session data
posts.json
caption.txt
output.jpg
used_stubs.json

# Allow images and reels to be committed for GitHub Pages
!images/
!reels/
!images/*.jpg
!images/*.png
!reels/*.mp4
!images/.gitkeep
!reels/.gitkeep

# Transient workflow trigger files (not part of repo content)
instagram_ready.flag
instagram_format.txt

# HyperFrames render deps are npm-installed in CI. git add -A in the gen
# workflow used to stage all of node_modules (~thousands of files) and the
# push died with "RPC failed; HTTP 408" before the publisher could run.
node_modules/
/package.json
/package-lock.json

# Transient generated data (keep repo clean)
reel_rotation.json
reels/test_reel_*.mp4

# Story posting transient flag
post_story.flag

# AI Horde raw image cache (transient, never commit)
images/.horde_cache.png
forwilma/images/.horde_cache.png
linkedin_fresh_token.txt
metrics.json
