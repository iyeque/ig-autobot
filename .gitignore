# Ignore Python bytecode
__pycache__/
*.py[cod]

# Ignore environment variables
.env

# Ignore IDE files
.vscode/
.idea/

# Ignore logs
*.log
generator_log_*.txt
*_log_*.txt

# Ignore temporary files
*.tmp
*.temp

# Ignore other files
.DS_Store
Thumbs.db

# Generated files and session data
posts.json
caption.txt
output.jpg

# Allow images and reels to be committed for GitHub Pages
!images/
!reels/
!images/*.jpg
!images/*.png
!reels/*.mp4
!images/.gitkeep
!reels/.gitkeep
