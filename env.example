# Required environment variables for ig-autobot

# Cerebras API key for caption generation
CEREBRAS_API_KEY="your_cerebras_api_key_here"

# DeepAI API key for image generation (used as fallback)
DEEPAI_API_KEY="your_deepai_api_key_here"

# AI Horde API key for primary image generation (register for free to get a key and avoid errors)
AI_HORDE_API_KEY="0000000000" # Replace with your registered key for better performance

# PDF filename for book context (e.g., "The-Nine-Stitches.pdf")
PDF_BOOK_FILENAME="The-Nine-Stitches.pdf"

# Instagram User ID (for posting)
IG_USER_ID="your_instagram_user_id_here"

# Instagram Access Token (for posting)
IG_ACCESS_TOKEN="your_instagram_access_token_here"

# Facebook App ID and Secret (may be required for some Graph API permissions)
FB_APP_ID="your_facebook_app_id_here"
FB_APP_SECRET="your_facebook_app_secret_here"
