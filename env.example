# === REQUIRED FOR ALL PLATFORMS ===
# Cerebras API key for caption generation
CEREBRAS_API_KEY="your_cerebras_api_key_here"

# AI Horde API key for image generation
AI_HORDE_API_KEY="0000000000"

# PDF filename for book context (e.g., "The-Nine-Stitches.pdf")
PDF_BOOK_FILENAME="The-Nine-Stitches.pdf"

# === INSTAGRAM / FACEBOOK ===
# Instagram Business Account ID
IG_USER_ID="your_instagram_user_id_here"

# Instagram Access Token (Long-lived)
IG_ACCESS_TOKEN="your_instagram_access_token_here"

# Optional: Facebook App credentials
FB_APP_ID="your_facebook_app_id_here"
FB_APP_SECRET="your_facebook_app_secret_here"

# === LINKEDIN ===
# LinkedIn OAuth2 Access Token
LINKEDIN_ACCESS_TOKEN="your_linkedin_access_token_here"

# Your Person or Organization URN (get this by running scripts/verify_linkedin.py)
LINKEDIN_URN="urn:li:person:YOUR_ID_HERE"

# === PINTEREST ===
# Pinterest V5 API Access Token
PINTEREST_ACCESS_TOKEN="your_pinterest_access_token_here"

# The unique ID of the board to pin to
PINTEREST_BOARD_ID="your_pinterest_board_id_here"

# === OPTIONAL ===
# OCR.space API key for image content detection/safety
OCR_SPACE_API_KEY="your_ocr_space_api_key_here"
